# Copy this file to .env and fill in your own values.
# The .env file is ignored by git so your secrets never get committed.

# Which media server you use: emby or plex.
SERVER_TYPE=emby

# ------------------------- Emby (SERVER_TYPE=emby) -------------------------

# Your Emby server address, e.g. http://192.168.1.10:8096 or https://emby.example.com
EMBY_URL=http://localhost:8096

# Emby API key: Emby Dashboard -> Advanced -> API Keys -> New API Key.
# Make a dedicated key just for this app so you can revoke it anytime.
EMBY_API_KEY=

# Your Emby username, so only YOUR playback shows up (recommended).
# Leave empty to show whatever is playing on any account.
EMBY_USERNAME=

# ------------------------- Plex (SERVER_TYPE=plex) -------------------------

# Your Plex server address, e.g. http://192.168.1.10:32400
PLEX_URL=

# Your Plex auth token. How to find it:
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token
# Note: Plex poster art needs IMGUR_CLIENT_ID below — Plex image links require
# this token inside the URL, and presence image URLs are visible to other
# Discord users, so they are never handed to Discord directly.
PLEX_TOKEN=

# Your Plex username, so only YOUR playback shows up (recommended).
PLEX_USERNAME=

# ------------------------------ Discord & app ------------------------------

# Discord Application ID: https://discord.com/developers/applications
# -> New Application (name it e.g. "Emby") -> copy the Application ID.
DISCORD_CLIENT_ID=

# Show real poster / album art on your Discord profile.
# Discord's servers fetch the image, so your Emby server must be reachable
# from the internet over https for this to work. If EMBY_URL above is a
# LAN address, put your public https address here (e.g. https://emby.example.com).
# Leave empty if EMBY_URL is already public https, or if you have no public URL
# (the status then falls back to the Emby logo).
EMBY_PUBLIC_URL=

# Set to false to never show poster art, even if a public URL is available.
SHOW_ARTWORK=true

# Imgur Client ID — enables poster art for Plex, and for Emby servers that
# have no public https address. Register (free, no callback needed) at:
# https://api.imgur.com/oauth2/addclient
# Copy only the Client ID here (NOT the client secret).
# Posters are uploaded to Imgur as anonymous unlisted images (once per
# show/movie, then cached in artwork_cache.json). Only the picture is
# uploaded — never your token or any account info. Leave empty to skip.
IMGUR_CLIENT_ID=

# How often to check Emby, in seconds (minimum 5).
POLL_INTERVAL=15

# Set to true to hide titles and only show "Watching a movie" etc.
HIDE_DETAILS=false

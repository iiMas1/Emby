# Copy this file to .env and fill in your own values.
# The .env file is ignored by git so your secrets never get committed.

# Your Emby server address, e.g. http://192.168.1.10:8096 or https://emby.example.com
EMBY_URL=http://localhost:8096

# Emby API key: Emby Dashboard -> Advanced -> API Keys -> New API Key.
# Make a dedicated key just for this app so you can revoke it anytime.
EMBY_API_KEY=

# Your Emby username, so only YOUR playback shows up (recommended).
# Leave empty to show whatever is playing on any account.
EMBY_USERNAME=

# Discord Application ID: https://discord.com/developers/applications
# -> New Application (name it e.g. "Emby") -> copy the Application ID.
DISCORD_CLIENT_ID=

# How often to check Emby, in seconds (minimum 5).
POLL_INTERVAL=15

# Set to true to hide titles and only show "Watching a movie" etc.
HIDE_DETAILS=false
